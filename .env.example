# KIU Admission Portal - Environment Configuration
# Official Kampala International University environment template
# Copy this file to .env and fill in your actual KIU values

# Database Configuration (MySQL with PyMySQL for KIU systems)
DATABASE_URL=mysql+pymysql://kiu_user:changeme_secure_password@localhost:3306/kiu_portal

# Docker Compose Database Password (required for KIU docker-compose.yml)
DB_PASSWORD=changeme_secure_password

# Docker MySQL root password (required for KIU docker-compose.yml)
DB_ROOT_PASSWORD=root_password_change_me

# Security - Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# These are required for KIU production security
JWT_SECRET=your-kiu-jwt-secret-here-change-this
SECRET_KEY=your-kiu-secret-key-here-change-this

# Redis Configuration (for KIU caching, rate limiting, and JWT token blacklist)
# Benefits: Faster KIU cache operations, persistent JWT revocation, shared state across KIU workers
# 
# Local Redis (single instance):
# REDIS_URL=redis://localhost:6379/0
#
# Redis with password:
# REDIS_URL=redis://:your_password@localhost:6379/0
#
# Docker Compose (service name):
# REDIS_URL=redis://redis:6379/0
#
# Production (Redis Cloud/AWS ElastiCache):
# REDIS_URL=redis://username:password@host:port/0
#
# Leave empty to use in-memory cache (fallback, no persistence)
REDIS_URL=redis://localhost:6379/0

# CORS Origins (comma-separated) - KIU frontend domains
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://admissions.kiu.ac.ug

# Flask Environment for KIU systems
FLASK_ENV=development

# Email Configuration (Brevo SMTP) - Optional for KIU notifications
BREVO_SMTP_USER=
BREVO_SMTP_KEY=

# Logging for KIU systems
LOG_LEVEL=INFO

# Feature Flags for KIU Admission Portal
SEED_DATABASE=true
REPLACE_PROGRAMS=false
