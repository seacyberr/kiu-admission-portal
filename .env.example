# =============================================================================
# KIU Admission Portal — Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control!

# ── Database ──────────────────────────────────────────────────────────────────
# Choose ONE of the following database configurations:

# Option A: MySQL (local development, standard port 3306)
DATABASE_URL=mysql+pymysql://root@localhost:3306/kiu_admissions

# Option B: PostgreSQL (Replit / Neon / Render)
# DATABASE_URL=postgresql://user:password@localhost:5432/kiu_admissions

# Option C: PostgreSQL via Heroku/Render (auto-converted to postgresql://)
# DATABASE_URL=postgres://user:password@host:5432/dbname

# ── Security ──────────────────────────────────────────────────────────────────
# Generate a strong key: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-random-secret-key

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Use * for development only.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# ── Email (Brevo SMTP) ───────────────────────────────────────────────────────
# 1. Sign up FREE at https://www.brevo.com/ (300 emails/day free)
# 2. Go to SMTP & API → SMTP tab
# 3. Create SMTP credentials
# 4. Paste your SMTP login and key below
# NOTE: OTPs always print in terminal even without SMTP configured
BREVO_SMTP_USER=your-smtp-login@smtp-brevo.com
BREVO_SMTP_KEY=your-smtp-key-here

# ── App ───────────────────────────────────────────────────────────────────────
PORT=5001
FLASK_DEBUG=false