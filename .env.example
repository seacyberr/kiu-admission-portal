# Copy to .env and fill in real values. Never commit .env.

# --- Database (required in production) — MySQL only (mysql+pymysql://...)
DATABASE_URL=mysql+pymysql://user:password@127.0.0.1:3306/kiu_admissions

# --- Secrets (required in production)
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
# Optional alias if your host only provides SECRET_KEY:
# SECRET_KEY=

# --- CORS (set explicit origins in production, comma-separated)
CORS_ORIGINS=https://your-frontend.example.com

# --- API server
PORT=5001
FLASK_ENV=production

# --- OTP debug (do not enable in production)
# When true, OTP codes are printed to terminal (useful for local testing).
# When false, OTP codes are not printed.
# If you do not set this variable, the backend falls back to printing only
# when FLASK_ENV != production.
OTP_DEBUG=false

# --- Rate limiting (use Redis when running multiple Gunicorn workers / instances)
# RATE_LIMIT_STORAGE_URI=redis://127.0.0.1:6379/0
# RATE_LIMIT_DEFAULT=200 per day, 50 per hour

# --- TLS / headers (behind HTTPS terminator, set ENABLE_HSTS=true if appropriate)
# ENABLE_HSTS=true
# ENABLE_SECURITY_HEADERS=true

# --- Logging
# LOG_LEVEL=INFO

# --- Seed demo data + default admin on empty DB (disable in production if you manage data elsewhere)
# SEED_DATABASE=true

# --- Refresh/replace the full programme catalogue on startup (can overwrite existing programmes)
# Only use when you intentionally want to re-import the KIU programme list.
# Default is safe (do not overwrite production data).
# REPLACE_PROGRAMS=false
REPLACE_PROGRAMS=false

# --- Email OTP (Brevo)
# BREVO_SMTP_USER=
# BREVO_SMTP_KEY=
