# KIU Admission Portal - Environment Configuration
# Copy this file to .env and fill in your actual values

# Database Configuration (MySQL with PyMySQL)
DATABASE_URL=mysql+pymysql://kiu_user:changeme_secure_password@localhost:3306/kiu_portal

# Docker Compose Database Password (required for docker-compose.yml)
DB_PASSWORD=changeme_secure_password

# Docker MySQL root password (required for docker-compose.yml)
DB_ROOT_PASSWORD=root_password_change_me

# Security - Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your-jwt-secret-here-change-this
SECRET_KEY=your-secret-key-here-change-this

# Redis Configuration (for caching, rate limiting, and JWT token blacklist)
# Benefits: Faster cache operations, persistent JWT revocation, shared state across workers
# 
# Local Redis (single instance):
# REDIS_URL=redis://localhost:6379/0
#
# Redis with password:
# REDIS_URL=redis://:your_password@localhost:6379/0
#
# Docker Compose (service name):
# REDIS_URL=redis://redis:6379/0
#
# Production (Redis Cloud/AWS ElastiCache):
# REDIS_URL=redis://username:password@host:port/0
#
# Leave empty to use in-memory cache (fallback, no persistence)
REDIS_URL=redis://localhost:6379/0

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Flask Environment
FLASK_ENV=development

# Email Configuration (Brevo SMTP) - Optional
BREVO_SMTP_USER=
BREVO_SMTP_KEY=

# Logging
LOG_LEVEL=INFO

# Feature Flags
SEED_DATABASE=true
REPLACE_PROGRAMS=false
