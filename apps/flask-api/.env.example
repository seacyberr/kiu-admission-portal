# Copy to ../../.env (repo root) or apps/flask-api/.env — matches config.py behaviour.

FLASK_ENV=development

# Required in production / normal runs (DevelopmentConfig supplies a dev fallback).
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
SECRET_KEY=

DATABASE_URL=mysql+pymysql://user:password@localhost:3306/kiu_admissions
# Optional local fallback: DATABASE_URL=sqlite:///kiu_admission.db

# Comma-separated; avoid "*" with cookie auth (credentials).
CORS_ORIGINS=http://localhost:5173

# Uploads — must match Config.MAX_CONTENT_LENGTH (5 MiB default)
MAX_CONTENT_LENGTH=5242880

# Leave false in production unless you intentionally seed demo data.
SEED_DATABASE=false
REPLACE_PROGRAMS=false

REDIS_URL=
CACHE_REDIS_URL=
RATE_LIMIT_STORAGE_URI=memory://

SENTRY_DSN=
LOG_LEVEL=INFO

BREVO_SMTP_USER=
BREVO_SMTP_KEY=
